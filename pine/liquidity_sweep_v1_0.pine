//@version=6
import TradingView/ta/14 as tvta

strategy("5-Step Liquidity Sweep | Research V1.0", overlay = true, initial_capital = 10000, currency = currency.USD, pyramiding = 0, commission_type = strategy.commission.percent, commission_value = 0.06, slippage = 2, margin_long = 100, margin_short = 100, process_orders_on_close = true, calc_on_every_tick = false)

// 1) Market context: use only CLOSED higher-timeframe bars.
gTrend = "1. 大周期结构"
htf           = input.timeframe("1D", "趋势周期", group = gTrend)
fastLen       = input.int(50, "快EMA", minval = 2, group = gTrend)
slowLen       = input.int(200, "慢EMA", minval = 3, group = gTrend)
trendFilter   = input.bool(true, "启用趋势过滤", group = gTrend)
direction     = input.string("双向", "交易方向", options = ["双向", "只做多", "只做空"], group = gTrend)

// 2) Known liquidity references: no future pivots or lookahead.
gSetup = "2-3. 流动性扫盘与结构确认"
liqLen        = input.int(20, "前高/前低回看K线", minval = 5, maxval = 300, group = gSetup)
confirmBars   = input.int(4, "扫盘后最多等待K线", minval = 1, maxval = 20, group = gSetup)
minVolRatio   = input.float(0.8, "扫盘成交量/20均量最低比", minval = 0.0, step = 0.1, group = gSetup)

// 4) Volume Delta derived from lower-timeframe data, NOT a true trade tape.
gFlow = "4. Delta/CVD与可选衍生品数据"
ltf            = input.timeframe("5", "Delta估算低周期", group = gFlow)
deltaFilter    = input.string("扫盘吸收", "Delta过滤", options = ["关闭", "扫盘吸收", "确认同向", "吸收+确认"], group = gFlow)
oiTicker       = input.string("", "OI数据代码（留空则不读取）", group = gFlow)
fundTicker     = input.string("", "资金费率代码（留空则不读取）", group = gFlow)

// 5) Explicit risk budget; no automatic leverage.
gRisk = "5. 风险和退出"
riskPct        = input.float(0.5, "单笔预设风险占权益 %", minval = 0.1, maxval = 3.0, step = 0.1, group = gRisk)
rr             = input.float(2.0, "目标盈亏比 R", minval = 0.5, maxval = 10.0, step = 0.25, group = gRisk)
atrLen         = input.int(14, "ATR周期", minval = 2, group = gRisk)
stopAtrBuffer  = input.float(0.20, "止损额外ATR缓冲", minval = 0.0, maxval = 2.0, step = 0.05, group = gRisk)
maxStopATR     = input.float(3.0, "最大止损距离（ATR倍数）", minval = 0.5, step = 0.25, group = gRisk)
maxExposurePct = input.float(95, "最大名义仓位/权益 %", minval = 10, maxval = 100, step = 5, group = gRisk)

// Safeguards against invalid lower/higher timeframe requests.
if barstate.isfirst
    if not timeframe.isintraday or timeframe.in_seconds(timeframe.period) >= timeframe.in_seconds("1D")
        runtime.error("请使用1日以下的日内K线，例如15分钟或1小时。")
    if timeframe.in_seconds(ltf) >= timeframe.in_seconds(timeframe.period)
        runtime.error("Delta低周期必须低于图表周期。例如1小时图搭配5分钟。")
    if timeframe.in_seconds(htf) <= timeframe.in_seconds(timeframe.period)
        runtime.error("趋势周期必须高于图表周期，例如1小时图搭配1日。")

[htfClose, htfFast, htfSlow] = request.security(syminfo.tickerid, htf, [close[1], ta.ema(close, fastLen)[1], ta.ema(close, slowLen)[1]], lookahead = barmerge.lookahead_on)
bullBias = htfClose > htfFast and htfFast > htfSlow
bearBias = htfClose < htfFast and htfFast < htfSlow
mayLong  = (not trendFilter or bullBias) and direction != "只做空"
mayShort = (not trendFilter or bearBias) and direction != "只做多"

liqHigh = ta.highest(high[1], liqLen)
liqLow  = ta.lowest(low[1], liqLen)
atr     = ta.atr(atrLen)
avgVol  = ta.sma(volume, 20)
volOK   = not na(avgVol) and volume >= avgVol * minVolRatio

// Official ta library's CVD is based on classified lower-TF volume.
// The 1D anchor resets the cumulative value every new day.
[cvdOpen, cvdHigh, cvdLow, cvdClose] = tvta.requestVolumeDelta(ltf, "1D")
barDelta = cvdClose - cvdOpen

// OI/funding are informational; missing feeds do not silently block signals.
float oiValue = na
float fundingRaw = na
if oiTicker != ""
    oiValue := request.security(oiTicker, timeframe.period, close, ignore_invalid_symbol = true)
if fundTicker != ""
    fundingRaw := request.security(fundTicker, timeframe.period, close, ignore_invalid_symbol = true)
oiChange = oiValue - oiValue[1]

needSweepDelta = deltaFilter == "扫盘吸收" or deltaFilter == "吸收+确认"
needEntryDelta = deltaFilter == "确认同向" or deltaFilter == "吸收+确认"

// Sweep = wick beyond PREVIOUS range, then close back inside.
longSweep  = barstate.isconfirmed and mayLong and volOK and not na(liqLow)  and low < liqLow   and close > liqLow  and (not needSweepDelta or (not na(barDelta) and barDelta < 0))
shortSweep = barstate.isconfirmed and mayShort and volOK and not na(liqHigh) and high > liqHigh and close < liqHigh and (not needSweepDelta or (not na(barDelta) and barDelta > 0))

var bool  pendingLong  = false
var bool  pendingShort = false
var float longTrigger  = na
var float shortTrigger = na
var float longSweepLow = na
var float shortSweepHi = na
var float longATR      = na
var float shortATR     = na
var int   longBar      = na
var int   shortBar     = na
var float tradeSL      = na
var float tradeTP      = na

bool longSignal  = false
bool shortSignal = false

if barstate.isconfirmed
    // Expire old setups and invalidate a setup if its sweep extreme is lost.
    if pendingLong and (bar_index - longBar > confirmBars or low <= longSweepLow)
        pendingLong := false
    if pendingShort and (bar_index - shortBar > confirmBars or high >= shortSweepHi)
        pendingShort := false

    if strategy.position_size == 0
        if longSweep
            pendingLong  := true
            pendingShort := false
            longTrigger  := high
            longSweepLow := low
            longATR      := atr
            longBar      := bar_index
        else if shortSweep
            pendingShort := true
            pendingLong  := false
            shortTrigger := low
            shortSweepHi := high
            shortATR     := atr
            shortBar     := bar_index

        bool longReady  = pendingLong  and bar_index > longBar  and close > longTrigger  and mayLong  and (not needEntryDelta or (not na(barDelta) and barDelta > 0))
        bool shortReady = pendingShort and bar_index > shortBar and close < shortTrigger and mayShort and (not needEntryDelta or (not na(barDelta) and barDelta < 0))

        if longReady
            float stopPrice = longSweepLow - longATR * stopAtrBuffer
            float stopDist  = close - stopPrice
            bool validRisk  = not na(stopDist) and stopDist > syminfo.mintick and stopDist <= atr * maxStopATR and strategy.equity > 0
            if validRisk
                float riskCash  = strategy.equity * riskPct / 100.0
                float riskQty   = riskCash / (stopDist * syminfo.pointvalue)
                float capQty    = strategy.equity * maxExposurePct / 100.0 / (close * syminfo.pointvalue)
                float qty       = math.min(riskQty, capQty)
                if qty > 0
                    longSignal := true
                    tradeSL := stopPrice
                    tradeTP := close + stopDist * rr
                    strategy.entry("L", strategy.long, qty = qty, alert_message = "5STEP_LONG_ENTRY")
                    strategy.exit("L-Exit", from_entry = "L", stop = tradeSL, limit = tradeTP, alert_message = "5STEP_LONG_EXIT")
                    alert("5-Step LONG | " + syminfo.ticker + " | Signal close: " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
            pendingLong := false

        if shortReady
            float stopPrice = shortSweepHi + shortATR * stopAtrBuffer
            float stopDist  = stopPrice - close
            bool validRisk  = not na(stopDist) and stopDist > syminfo.mintick and stopDist <= atr * maxStopATR and strategy.equity > 0
            if validRisk
                float riskCash  = strategy.equity * riskPct / 100.0
                float riskQty   = riskCash / (stopDist * syminfo.pointvalue)
                float capQty    = strategy.equity * maxExposurePct / 100.0 / (close * syminfo.pointvalue)
                float qty       = math.min(riskQty, capQty)
                if qty > 0
                    shortSignal := true
                    tradeSL := stopPrice
                    tradeTP := close - stopDist * rr
                    strategy.entry("S", strategy.short, qty = qty, alert_message = "5STEP_SHORT_ENTRY")
                    strategy.exit("S-Exit", from_entry = "S", stop = tradeSL, limit = tradeTP, alert_message = "5STEP_SHORT_EXIT")
                    alert("5-Step SHORT | " + syminfo.ticker + " | Signal close: " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
            pendingShort := false

    // Clear the visuals when a previously open position has closed.
    if strategy.position_size == 0 and strategy.position_size[1] != 0
        tradeSL := na
        tradeTP := na

plot(liqHigh, "Prior range high / buy-side liquidity", color = color.new(color.red, 50), style = plot.style_linebr)
plot(liqLow, "Prior range low / sell-side liquidity", color = color.new(color.teal, 50), style = plot.style_linebr)
plot(tradeSL, "Fixed stop", color = color.red, style = plot.style_linebr, linewidth = 2)
plot(tradeTP, "Fixed target", color = color.lime, style = plot.style_linebr, linewidth = 2)
plotshape(longSweep, title = "Sell-side sweep", style = shape.circle, location = location.belowbar, color = color.teal, size = size.tiny, text = "SW")
plotshape(shortSweep, title = "Buy-side sweep", style = shape.circle, location = location.abovebar, color = color.orange, size = size.tiny, text = "SW")
plotshape(longSignal, title = "Long confirmation", style = shape.triangleup, location = location.belowbar, color = color.lime, size = size.small, text = "L")
plotshape(shortSignal, title = "Short confirmation", style = shape.triangledown, location = location.abovebar, color = color.red, size = size.small, text = "S")

// Raw series visible in TradingView's Data Window (no incompatible scales on price chart).
plot(barDelta, "Estimated bar Delta", display = display.data_window)
plot(cvdClose, "Estimated daily CVD", display = display.data_window)
plot(oiValue, "OI (optional)", display = display.data_window)
plot(fundingRaw, "Funding raw (optional)", display = display.data_window)

var table status = table.new(position.top_right, 2, 7, border_width = 1)
if barstate.islast
    table.cell(status, 0, 0, "5-Step V1", text_color = color.white, bgcolor = color.new(color.blue, 55))
    table.cell(status, 1, 0, "Research", text_color = color.white, bgcolor = color.new(color.blue, 55))
    table.cell(status, 0, 1, "日线方向")
    table.cell(status, 1, 1, bullBias ? "偏多" : bearBias ? "偏空" : "中性")
    table.cell(status, 0, 2, "下方流动性")
    table.cell(status, 1, 2, str.tostring(liqLow, format.mintick))
    table.cell(status, 0, 3, "估算Delta")
    table.cell(status, 1, 3, na(barDelta) ? "无数据" : str.tostring(barDelta, "#.##"))
    table.cell(status, 0, 4, "日内CVD")
    table.cell(status, 1, 4, na(cvdClose) ? "无数据" : str.tostring(cvdClose, "#.##"))
    table.cell(status, 0, 5, "OI变化")
    table.cell(status, 1, 5, na(oiChange) ? "未连接" : str.tostring(oiChange, "#.##"))
    table.cell(status, 0, 6, "费率(原值)")
    table.cell(status, 1, 6, na(fundingRaw) ? "未连接" : str.tostring(fundingRaw, "#.########"))